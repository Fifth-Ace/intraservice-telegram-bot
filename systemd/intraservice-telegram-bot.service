[Unit]
Description=IntraService Telegram Bot Community Edition
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/intraservice-telegram-bot
ExecStart=/usr/bin/env node --no-warnings %h/intraservice-telegram-bot/src/app.mjs
Restart=always
RestartSec=10
TimeoutStopSec=45
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=NODE_ENV=production
EnvironmentFile=%h/intraservice-telegram-bot/.env

[Install]
WantedBy=default.target
